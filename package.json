{
  "name": "opencode-shell-magazine",
  "version": "0.1.1",
  "description": "OpenCode TUI plugin monitoring shell commands in real time",
  "type": "module",
  "exports": {
    "./tui": {
      "import": "./tui/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "tui",
    "install.mjs",
    "README.md"
  ],
  "bin": {
    "opencode-shell-magazine": "install.mjs"
  },
  "scripts": {
    "build": "node build.tui.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "version": "node -e \"require('fs').writeFileSync('src/_version.ts','// auto-generated\\nexport const PLUGIN_VERSION='+JSON.stringify(require('./package.json').version)+';\\n')\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "shell",
    "terminal",
    "command"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiev/opencode-shell-magazine.git"
  },
  "license": "MIT",
  "peerDependencies": {
    "@opentui/core": ">=0.5.8",
    "@opentui/solid": ">=0.5.8",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "esbuild-plugin-solid": "^0.5.0",
    "tsx": "^4.22.3",
    "typescript": "^5.8.0"
  }
}
